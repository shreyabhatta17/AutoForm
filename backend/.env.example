# Copy to backend/.env for local runs, or set these as environment variables on your host.

# --- Database ------------------------------------------------------------------
# Leave unset locally to use SQLite (backend/data/app.db).
# For hosting, use a persistent Postgres database, e.g. Neon (free): postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

# --- Answer generation -----------------------------------------------------------
# auto   = use the hosted API when LLM_API_KEY is set, otherwise local Ollama
# openai = any OpenAI-compatible API (Groq, OpenRouter, Together, Google Gemini, OpenAI...)
# ollama = local / self-hosted Ollama
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=
# Optional hosted-model reasoning effort; leave blank to use the provider default.
LLM_REASONING_EFFORT=
# Extra hosted max tokens (0-2000); this does not affect local Ollama.
LLM_MAX_TOKENS_EXTRA=0

# Local Ollama (used when the provider is ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- Abuse protection ------------------------------------------------------------
REGISTER_LIMIT_PER_HOUR=20
GENERATE_LIMIT_PER_HOUR=30
CV_UPLOAD_LIMIT_PER_HOUR=20
