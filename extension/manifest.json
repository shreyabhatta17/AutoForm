{
  "manifest_version": 3,
  "name": "AutoForm – Reviewed Form Filler",
  "version": "1.1.0",
  "description": "Fills web forms from your saved profile and drafts written answers. You review every value; forms are never submitted for you.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://autoform-shreya.onrender.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoForm"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b2f535f7-276d-433d-a7e2-d4ac3e571ca9}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "websiteContent"]
      }
    }
  }
}
